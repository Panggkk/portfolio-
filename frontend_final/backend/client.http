# 1. เพิ่มภูมิภาค(ตามจังหวัด)และเขต 
GET {{baseURL}}/regions/

### [1.1] สร้างภูมิภาค: จังหวัดเชียงใหม่ กรอกซ้ำขึ้นว่า "region_id นี้มีอยู่ในระบบแล้ว"
POST {{baseURL}}/regions/

{"region_id":1,"name_th": "เชียงใหม่", "total_population": 6000000 }

### [1.2] สร้างเขต 1 (อำเภอเมืองเชียงใหม่) กรอกซ้ำขึ้นว่า "const_id นี้มีอยู่ในระบบแล้ว"
POST {{baseURL}}/constituencies/

{ "region_id": 1, "const_id": 1, "const_number": 1, "total_eligible_voters": 100000 }

### [1.3] สร้างเขต 8 (อำเภอหางดง-สันป่าตอง) กรอกซ้ำขึ้นว่า "const_id นี้มีอยู่ในระบบแล้ว"
POST {{baseURL}}/constituencies/

{ "region_id": 1, "const_id": 2, "const_number": 8, "total_eligible_voters": 120000 }

##เช็ค มี2 เขตแล้ว
GET {{baseURL}}/constituencies/



